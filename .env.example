# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" (default, fully local) or "anthropic" (cloud)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Embedding model — must be pulled in Ollama: `ollama pull nomic-embed-text`
EMBED_MODEL=nomic-embed-text

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Cloud API Keys (only needed when LLM_PROVIDER=anthropic) ─────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here   # optional, not used by default

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./lenny.db

# For PostgreSQL (Supabase): postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres
# For PostgreSQL (Railway):  get the connection string from your Railway project dashboard
# For local PostgreSQL:      postgresql+asyncpg://postgres:password@localhost:5432/lenny_db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=lenny_transcripts

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TOP_K=5
TRANSCRIPT_DIR=./transcripts

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
